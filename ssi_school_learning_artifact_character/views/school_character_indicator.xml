<odoo>
<record id="school_character_indicator_view_form" model="ir.ui.view">
    <field name="name">school_character_indicator - form (grade status)</field>
    <field name="model">school_character_indicator</field>
    <field
            name="inherit_id"
            ref="ssi_school_character.school_character_indicator_view_form"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//page[@name='indicator']" position="after">
                <page name="grade_status" string="Grade Status">
                    <field name="grade_status_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="grade_type_id" />
                            <field name="status" />
                        </tree>
                        <form>
                            <group name="grade_status_1">
                                <field name="grade_type_id" />
                                <field name="status" />
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>
</odoo>
