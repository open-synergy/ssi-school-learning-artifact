<odoo>
<record
        id="school_learning_artifact_showcase_channel_operating_unit_rule"
        model="ir.rule"
    >
    <field
            name="name"
        >School Learning Artifact Showcase Channel - Responsible to operating unit data</field>
    <field
            name="model_id"
            ref="ssi_school_learning_artifact.model_school_learning_artifact_showcase_channel"
        />
    <field
            name="groups"
            eval="[(4, ref('school_learning_artifact_operating_unit_group'))]"
        />
    <field
            name="domain_force"
        >['|', ('school_ids', '=', False), ('school_ids.operating_unit_ids', 'in', [g.id for g in user.operating_unit_ids])]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<record id="school_learning_artifact_showcase_channel_company_rule" model="ir.rule">
    <field name="name">School Learning Artifact Showcase Channel - Company</field>
    <field
            name="model_id"
            ref="ssi_school_learning_artifact.model_school_learning_artifact_showcase_channel"
        />
    <field
            name="groups"
            eval="[(4, ref('ssi_school_learning_artifact.school_learning_artifact_company_group'))]"
        />
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>
</odoo>
