<odoo>
<record
        id="policy_template_school_learning_artifact_showcase_production"
        model="policy.template"
    >
    <field name="name">Standard</field>
    <field name="model_id" ref="model_school_learning_artifact_showcase_production" />
    <field
            name="state_field_id"
            search="[('model_id.model','=','school_learning_artifact_showcase_production'),('name','=','state')]"
        />
    <field name="sequence" eval="100" />
    <field name="python_code">result=True</field>
</record>

<!-- approve_ok -->
<record
        id="policy_template_school_learning_artifact_showcase_production_approve"
        model="policy.template_detail"
    >
    <field
            name="template_id"
            ref="policy_template_school_learning_artifact_showcase_production"
        />
    <field
            name="field_id"
            search="[('model_id.model','=','school_learning_artifact_showcase_production'),('name','=','approve_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','school_learning_artifact_showcase_production'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="0" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- reject_ok -->
<record
        id="policy_template_school_learning_artifact_showcase_production_reject"
        model="policy.template_detail"
    >
    <field
            name="template_id"
            ref="policy_template_school_learning_artifact_showcase_production"
        />
    <field
            name="field_id"
            search="[('model_id.model','=','school_learning_artifact_showcase_production'),('name','=','reject_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','school_learning_artifact_showcase_production'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="0" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- restart_approval_ok -->
<record
        id="policy_template_school_learning_artifact_showcase_production_restart_approval"
        model="policy.template_detail"
    >
    <field
            name="template_id"
            ref="policy_template_school_learning_artifact_showcase_production"
        />
    <field
            name="field_id"
            search="[('model_id.model','=','school_learning_artifact_showcase_production'),('name','=','restart_approval_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','school_learning_artifact_showcase_production'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field
            name="group_ids"
            eval="[(6,0,[ref('school_learning_artifact_inventory_coordinator_group')])]"
        />
    <field name="restrict_additional" eval="0" />
</record>
</odoo>
