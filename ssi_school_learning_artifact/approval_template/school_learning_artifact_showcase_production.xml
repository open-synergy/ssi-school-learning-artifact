<odoo>
<!-- The template has no detail on purpose: the administrator adds the
     approvers (for example the principal, then the branch person in
     charge). Until then the approval of a narrative is refused. -->
<record
        id="approval_template_school_learning_artifact_showcase_production"
        model="approval.template"
    >
    <field name="name">Standard</field>
    <field name="model_id" ref="model_school_learning_artifact_showcase_production" />
    <field name="sequence" eval="100" />
    <field name="computation_method">use_python</field>
    <field name="python_code">result = True</field>
    <field name="validate_sequence" eval="1" />
</record>
</odoo>
