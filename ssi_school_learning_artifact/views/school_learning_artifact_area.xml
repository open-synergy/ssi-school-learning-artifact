<odoo>
<record id="school_learning_artifact_area_view_search" model="ir.ui.view">
    <field name="name">school_learning_artifact_area - search</field>
    <field name="model">school_learning_artifact_area</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="school_id" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_school_id"
                            string="School"
                            context="{'group_by': 'school_id'}"
                        />
                    <filter
                            name="group_by_area_type"
                            string="Area Type"
                            context="{'group_by': 'area_type'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_learning_artifact_area_view_tree" model="ir.ui.view">
    <field name="name">school_learning_artifact_area - tree</field>
    <field name="model">school_learning_artifact_area</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <field name="school_id" />
                <field name="area_type" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_learning_artifact_area_view_form" model="ir.ui.view">
    <field name="name">school_learning_artifact_area - form</field>
    <field name="model">school_learning_artifact_area</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
                <field name="school_id" />
                <field name="area_type" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_learning_artifact_area_action" model="ir.actions.act_window">
    <field name="name">Learning Artifact Areas</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_learning_artifact_area</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_learning_artifact_area_menu"
        name="Areas"
        parent="menu_school_learning_artifact_configuration"
        action="school_learning_artifact_area_action"
        groups="school_learning_artifact_area_group"
        sequence="110"
    />

</odoo>
