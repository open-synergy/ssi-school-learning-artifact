<odoo>
<record id="school_learning_artifact_view_form_showcase" model="ir.ui.view">
    <field name="name">school_learning_artifact - form (showcase)</field>
    <field name="model">school_learning_artifact</field>
    <field name="inherit_id" ref="school_learning_artifact_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//header/field[@name='state']" position="before">
                <button
                        name="action_mark_consent_reviewed"
                        type="object"
                        string="Mark Consent Reviewed"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', '|', ('state', '!=', 'done'), ('consent_review_required', '=', False), ('consent_reviewed', '=', True)]}"
                    />
            </xpath>
            <xpath expr="//page[@name='curation']" position="after">
                <page
                        name="showcase"
                        string="Showcase"
                        attrs="{'invisible': [('state', '!=', 'done')]}"
                    >
                    <group name="showcase_1" colspan="4" col="2">
                        <group name="showcase_left" colspan="1" col="2">
                            <field
                                    name="showcase_stage_id"
                                    options="{'no_create': True}"
                                />
                            <field
                                    name="showcase_channel_ids"
                                    widget="many2many_tags"
                                    options="{'no_create': True}"
                                />
                            <field
                                    name="actual_channel_ids"
                                    widget="many2many_tags"
                                    options="{'no_create': True}"
                                />
                        </group>
                        <group name="showcase_right" colspan="1" col="2">
                            <field name="showcase_consent_ok" />
                            <field name="consent_review_required" />
                            <field name="consent_reviewed" />
                            <field name="consent_reviewed_by_id" />
                            <field name="promotion_allowed" />
                        </group>
                    </group>
                    <group name="showcase_production" string="Production">
                        <field name="production_ids" nolabel="1">
                            <tree editable="bottom">
                                <field
                                        name="channel_id"
                                        domain="['|', ('school_ids', '=', False), ('school_ids', 'in', parent.school_id)]"
                                        options="{'no_create': True}"
                                    />
                                <field name="content" />
                                <field name="content_word_count" />
                                <field name="pic_id" />
                                <field name="ready" />
                                <field name="date_published" />
                            </tree>
                            <form>
                                <group name="production_group" colspan="4" col="2">
                                    <field
                                            name="channel_id"
                                            domain="['|', ('school_ids', '=', False), ('school_ids', 'in', parent.school_id)]"
                                            options="{'no_create': True}"
                                        />
                                    <field name="content" />
                                    <field name="content_word_count" />
                                    <field name="pic_id" />
                                    <field name="ready" />
                                    <field name="date_published" />
                                    <field name="note" />
                                </group>
                            </form>
                        </field>
                    </group>
                    <group name="showcase_distribution" string="Distribution Note">
                        <field name="distribution_note" nolabel="1" />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_learning_artifact_view_kanban" model="ir.ui.view">
    <field name="name">school_learning_artifact - kanban</field>
    <field name="model">school_learning_artifact</field>
    <field name="arch" type="xml">
        <kanban
                default_group_by="showcase_stage_id"
                class="o_kanban_small_column"
                group_create="false"
                group_edit="false"
                group_delete="false"
                quick_create="false"
            >
            <field name="showcase_stage_id" />
            <field name="name" />
            <field name="activity_name" />
            <field name="school_id" />
            <field name="media_type" />
            <field name="curation_status_id" />
            <field name="showcase_consent_ok" />
            <field name="consent_review_required" />
            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_global_click">
                        <div class="o_kanban_record_title">
                            <strong><field name="activity_name" /></strong>
                        </div>
                        <div class="o_kanban_record_subtitle text-muted">
                            <field name="name" />
                            -
                            <field name="school_id" />
                        </div>
                        <div>
                            <field name="curation_status_id" />
                        </div>
                        <div>
                            <span
                                    t-if="record.showcase_consent_ok.raw_value"
                                    class="badge badge-pill badge-success"
                                >Consent OK</span>
                            <span
                                    t-if="record.consent_review_required.raw_value"
                                    class="badge badge-pill badge-warning"
                                >Review</span>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>

<record id="school_learning_artifact_showcase_action" model="ir.actions.act_window">
    <field name="name">Showcase</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_learning_artifact</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="domain">[('state', '=', 'done')]</field>
    <field name="search_view_id" ref="school_learning_artifact_view_search" />
</record>

<menuitem
        id="school_learning_artifact_showcase_menu"
        name="Showcase"
        parent="menu_school_learning_artifact"
        action="school_learning_artifact_showcase_action"
        groups="school_learning_artifact_viewer_group"
        sequence="20"
    />

</odoo>
