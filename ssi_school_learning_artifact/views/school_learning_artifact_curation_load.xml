<odoo>

<record id="school_learning_artifact_curation_load_view_search" model="ir.ui.view">
    <field name="name">school_learning_artifact_curation_load - search</field>
    <field name="model">school_learning_artifact_curation_load</field>
    <field name="arch" type="xml">
        <search string="Learning Artifact Curation Load">
            <field name="assessor_id" />
            <field name="artifact_id" />
            <field name="criterion_id" />
            <field name="school_id" />
            <field name="academic_year_id" />
            <filter
                    name="filter_not_cancelled"
                    string="Not Cancelled"
                    domain="[('state', '!=', 'cancel')]"
                />
            <filter
                    name="filter_scored_aspect"
                    string="Scored Aspect"
                    domain="[('aspect_type', '=', 'score')]"
                />
            <filter
                    name="filter_ethics_gate"
                    string="Ethics Gate"
                    domain="[('aspect_type', '=', 'gate')]"
                />
            <group expand="0" string="Group By">
                <filter
                        name="group_by_assessor_id"
                        string="Assessor"
                        context="{'group_by': 'assessor_id'}"
                    />
                <filter
                        name="group_by_criterion_id"
                        string="Aspect"
                        context="{'group_by': 'criterion_id'}"
                    />
                <filter
                        name="group_by_school_id"
                        string="School"
                        context="{'group_by': 'school_id'}"
                    />
            </group>
        </search>
    </field>
</record>

<record id="school_learning_artifact_curation_load_view_pivot" model="ir.ui.view">
    <field name="name">school_learning_artifact_curation_load - pivot</field>
    <field name="model">school_learning_artifact_curation_load</field>
    <field name="arch" type="xml">
        <pivot string="Learning Artifact Curation Load" disable_linking="True">
            <field name="assessor_id" type="row" />
            <field name="aspect_type" type="col" />
            <field name="aspect_count" type="measure" />
        </pivot>
    </field>
</record>

<record id="school_learning_artifact_curation_load_view_tree" model="ir.ui.view">
    <field name="name">school_learning_artifact_curation_load - tree</field>
    <field name="model">school_learning_artifact_curation_load</field>
    <field name="arch" type="xml">
        <tree create="false" edit="false" delete="false">
            <field name="assessor_id" />
            <field name="artifact_id" />
            <field name="school_id" />
            <field name="academic_year_id" />
            <field name="grade_type_id" />
            <field name="criterion_id" />
            <field name="aspect_type" />
            <field name="state" />
            <field name="aspect_count" sum="Assessed Aspects" />
        </tree>
    </field>
</record>

<record
        id="school_learning_artifact_curation_load_action"
        model="ir.actions.act_window"
    >
    <field name="name">Learning Artifact Curation Load</field>
    <field name="res_model">school_learning_artifact_curation_load</field>
    <field name="view_mode">pivot,tree</field>
    <field
            name="search_view_id"
            ref="school_learning_artifact_curation_load_view_search"
        />
    <field name="context">{'search_default_filter_not_cancelled': 1}</field>
</record>

<menuitem
        id="school_learning_artifact_curation_load_menu"
        name="Learning Artifact Curation Load"
        parent="ssi_school.menu_school_report"
        action="school_learning_artifact_curation_load_action"
        groups="school_learning_artifact_curation_load_group"
        sequence="10"
    />

</odoo>
