<odoo>
<record id="school_learning_artifact_curation_status_view_search" model="ir.ui.view">
    <field name="name">school_learning_artifact_curation_status - search</field>
    <field name="model">school_learning_artifact_curation_status</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="school_ids" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_category"
                            string="Category"
                            context="{'group_by': 'category'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_learning_artifact_curation_status_view_form" model="ir.ui.view">
    <field name="name">school_learning_artifact_curation_status - form</field>
    <field name="model">school_learning_artifact_curation_status</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
                <field name="category" />
                <field name="school_ids" widget="many2many_tags" />
            </xpath>
        </data>
    </field>
</record>

<record
        id="school_learning_artifact_curation_status_action"
        model="ir.actions.act_window"
    >
    <field name="name">Learning Artifact Curation Statuses</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_learning_artifact_curation_status</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_learning_artifact_curation_status_menu"
        name="Curation Statuses"
        parent="menu_school_learning_artifact_configuration"
        action="school_learning_artifact_curation_status_action"
        groups="school_learning_artifact_curation_status_group"
        sequence="160"
    />

</odoo>
