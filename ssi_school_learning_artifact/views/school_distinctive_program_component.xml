<odoo>
<record id="school_distinctive_program_component_view_search" model="ir.ui.view">
    <field name="name">school_distinctive_program_component - search</field>
    <field name="model">school_distinctive_program_component</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="program_id" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_program_id"
                            string="Program"
                            context="{'group_by': 'program_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_distinctive_program_component_view_tree" model="ir.ui.view">
    <field name="name">school_distinctive_program_component - tree</field>
    <field name="model">school_distinctive_program_component</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <field name="program_id" />
                <field name="abbreviation" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_distinctive_program_component_view_form" model="ir.ui.view">
    <field name="name">school_distinctive_program_component - form</field>
    <field name="model">school_distinctive_program_component</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
                <field name="abbreviation" />
                <field name="program_id" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_distinctive_program_component_action" model="ir.actions.act_window">
    <field name="name">Distinctive Program Components</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_distinctive_program_component</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_distinctive_program_component_menu"
        name="Program Components"
        parent="menu_school_learning_artifact_configuration"
        action="school_distinctive_program_component_action"
        groups="school_distinctive_program_component_group"
        sequence="160"
    />

</odoo>
