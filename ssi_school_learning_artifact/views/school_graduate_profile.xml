<odoo>
<record id="school_graduate_profile_view_search" model="ir.ui.view">
    <field name="name">school_graduate_profile - search</field>
    <field name="model">school_graduate_profile</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="grade_ids" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_graduate_profile_view_tree" model="ir.ui.view">
    <field name="name">school_graduate_profile - tree</field>
    <field name="model">school_graduate_profile</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="before">
                <field name="sequence" widget="handle" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_graduate_profile_view_form" model="ir.ui.view">
    <field name="name">school_graduate_profile - form</field>
    <field name="model">school_graduate_profile</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
                <field name="sequence" />
                <field name="grade_ids" widget="many2many_tags" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_graduate_profile_action" model="ir.actions.act_window">
    <field name="name">Graduate Profiles</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_graduate_profile</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_graduate_profile_menu"
        name="Graduate Profiles"
        parent="menu_school_learning_artifact_configuration"
        action="school_graduate_profile_action"
        groups="school_graduate_profile_group"
        sequence="170"
    />

</odoo>
