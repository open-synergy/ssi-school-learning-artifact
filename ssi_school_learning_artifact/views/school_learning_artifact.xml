<odoo>
<record id="school_learning_artifact_view_search" model="ir.ui.view">
    <field name="name">school_learning_artifact - search</field>
    <field name="model">school_learning_artifact</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="activity_name" />
                <field name="school_id" />
                <field name="grade_class_id" />
                <field name="student_ids" />
                <field name="curation_status_id" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_school_id"
                            string="School"
                            context="{'group_by': 'school_id'}"
                        />
                    <filter
                            name="group_by_academic_year_id"
                            string="Academic Year"
                            context="{'group_by': 'academic_year_id'}"
                        />
                    <filter
                            name="group_by_grade_class_id"
                            string="Class"
                            context="{'group_by': 'grade_class_id'}"
                        />
                    <filter
                            name="group_by_media_type"
                            string="Media Type"
                            context="{'group_by': 'media_type'}"
                        />
                    <filter
                            name="group_by_curation_status_id"
                            string="Curation Status"
                            context="{'group_by': 'curation_status_id'}"
                        />
                    <filter
                            name="group_by_category_id"
                            string="Category"
                            context="{'group_by': 'category_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_learning_artifact_view_tree" model="ir.ui.view">
    <field name="name">school_learning_artifact - tree</field>
    <field name="model">school_learning_artifact</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="date" />
                <field name="school_id" />
                <field name="academic_year_id" />
                <field name="grade_class_id" />
                <field name="activity_name" />
                <field name="media_type" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_learning_artifact_view_form" model="ir.ui.view">
    <field name="name">school_learning_artifact - form</field>
    <field name="model">school_learning_artifact</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="school_id" />
                <field name="academic_year_id" />
                <field name="grade_class_id" />
                <field name="grade_id" />
                <field name="grade_type_id" />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="date" />
                <field name="activity_name" />
                <field name="activity_type" />
                <field name="media_type" />
                <field name="graduate_profile_id" />
                <field name="curation_status_id" />
            </xpath>
            <xpath expr="//group[@name='header_center']" position="inside">
                <field name="student_ids" widget="many2many_tags" />
                <field name="allowed_component_ids" invisible="1" />
                <field name="allowed_dimension_ids" invisible="1" />
                <field name="allowed_phase_ids" invisible="1" />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="activity" string="Activity">
                    <group name="activity_1" colspan="4" col="2">
                        <group name="activity_left" colspan="1" col="2">
                            <field name="learning_area_id" />
                            <field name="category_id" />
                            <field name="activity_stage" />
                            <field name="achievement_level" />
                        </group>
                        <group name="activity_right" colspan="1" col="2">
                            <field name="primary_component_id" />
                            <field name="secondary_component_id" />
                            <field name="dimension_id" />
                            <field name="phase_id" />
                        </group>
                    </group>
                </page>
                <page name="media" string="Media">
                    <group name="media_1" colspan="4" col="2">
                        <field name="link_url" widget="url" />
                        <field name="description_word_count" />
                    </group>
                    <group name="media_description" string="Description">
                        <field name="description" nolabel="1" />
                    </group>
                </page>
                <page name="reflection" string="Reflection">
                    <group name="reflection_teacher" string="Teacher Reflection">
                        <field name="teacher_reflection" nolabel="1" />
                    </group>
                    <group name="reflection_student" string="Student Reflection">
                        <field name="student_reflection" nolabel="1" />
                    </group>
                </page>
            </xpath>
            <xpath expr="//page[@name='reflection']" position="after">
                <page name="consent" string="Parental Consent">
                    <group name="consent_1" colspan="4" col="2">
                        <group name="consent_left" colspan="1" col="2">
                            <field name="inventory_consent" />
                            <field name="assessment_consent" />
                        </group>
                        <group name="consent_right" colspan="1" col="2">
                            <field name="publication_consent" />
                            <field name="promotion_consent" />
                        </group>
                    </group>
                    <group name="consent_limited" string="Limited Publication">
                        <field
                                name="limited_publication_student_ids"
                                widget="many2many_tags"
                            />
                    </group>
                    <group name="consent_refused" string="Refusing Publication">
                        <field
                                name="refused_publication_student_ids"
                                widget="many2many_tags"
                            />
                    </group>
                </page>
                <page name="curation" string="Curation">
                    <group name="curation_1" colspan="4" col="2">
                        <group name="curation_left" colspan="1" col="2">
                            <field name="rubric_id" />
                            <field name="ethics_result" />
                            <field
                                    name="ethics_reason_id"
                                    attrs="{'invisible': [('ethics_result', '!=', 'fail')]}"
                                />
                            <field name="ethics_assessor_id" />
                        </group>
                        <group name="curation_right" colspan="1" col="2">
                            <field name="total_score" />
                            <field name="curation_status_category" />
                            <field name="revision_count" />
                            <field name="curated_by_id" />
                            <field name="date_curated" />
                        </group>
                    </group>
                    <group name="curation_score" string="Scores">
                        <field name="score_ids" nolabel="1">
                            <tree editable="bottom" create="false" delete="false">
                                <field name="sequence" invisible="1" />
                                <field name="criterion_id" readonly="1" />
                                <field name="score" />
                                <field name="assessor_id" />
                                <field name="date_score" />
                            </tree>
                            <form>
                                <group name="score_group" colspan="4" col="2">
                                    <field name="criterion_id" readonly="1" />
                                    <field name="score" />
                                    <field name="assessor_id" />
                                    <field name="date_score" />
                                </group>
                            </form>
                        </field>
                    </group>
                    <group name="curation_recommendation" string="Recommendation">
                        <field name="recommendation" nolabel="1" />
                    </group>
                    <group name="curation_note" string="Curator Note">
                        <field name="curator_note" nolabel="1" />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_learning_artifact_action" model="ir.actions.act_window">
    <field name="name">Learning Artifacts</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_learning_artifact</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_learning_artifact_menu"
        name="Learning Artifacts"
        parent="menu_school_learning_artifact"
        action="school_learning_artifact_action"
        groups="school_learning_artifact_viewer_group"
        sequence="10"
    />

</odoo>
